  "structures": [
    {
      "id": "nao-so",
      "regex": "(?i)\\bn[aã]o [eé] (?:s[oó]|apenas|somente) [^.!?\\n]{2,60}[,.] (?:[eé]|mas)\\b",
      "name": "Estrutura \"não é só X, é Y\"",
      "fix": "Diga a coisa que você realmente quer dizer. Apague a metade de preparação."
    },
    {
      "id": "nao-apenas-mas",
      "regex": "(?i)\\bn[aã]o apenas [^.!?\\n]{2,60}, mas tamb[eé]m\\b",
      "name": "Estrutura \"não apenas X, mas também Y\"",
      "fix": "Escolha o X ou o Y. Quem fala não monta frase de redação."
    },
    {
      "id": "mais-do-que",
      "regex": "(?i)\\bmais do que (?:apenas |s[oó] |somente )?[^.!?\\n]{2,50}, [eé] \\b",
      "name": "Estrutura \"mais do que X, é Y\"",
      "fix": "Vá direto ao Y."
    },
    {
      "id": "preambulo",
      "regex": "(?i)\\b(?:neste|nesse|no) v[ií]deo\\b|\\bv[ií]deo de hoje\\b|\\bhoje (?:eu )?(?:vou|vamos|quero)\\b",
      "name": "Preâmbulo de vídeo",
      "fix": "Apague e abra no ganho: o vídeo começa na frase do segundo seis."
    },
    {
      "id": "saudacao",
      "regex": "(?im)^\\s*(?:oi|ol[aá]|e a[ií]|fala|salve|bom dia|boa tarde|boa noite)\\b[^.!?\\n]{0,25}(?:pessoal|galera|gente|amigos?|queridos?)",
      "name": "Saudação de abertura",
      "fix": "Ninguém abriu o feed para ser cumprimentado."
    },
    {
      "id": "isca-seguir",
      "regex": "(?i)\\b(?:segue|siga|me segue|me siga)\\b[^.!?\\n]{0,30}\\b(?:mais|conte[uú]dos?|dicas)\\b",
      "name": "Isca de seguir por reflexo",
      "fix": "Peça uma coisa só, com motivo: salvar, comentar a palavra ou seguir porque haverá parte 2."
    },
    {
      "id": "isca-marcar",
      "regex": "(?i)\\bmarc(?:a|que|ar)\\b[^.!?\\n]{0,30}\\b(?:amigo|amiga|alguem|alguém|aquele|aquela|pessoa)\\b",
      "name": "Isca de marcar alguém",
      "fix": "Troque por um pedido que a pessoa faria sozinha."
    },
    {
      "id": "sabia-que",
      "regex": "(?im)^\\s*voc[eê] (?:j[aá] )?(?:sabia|percebeu|parou pra pensar)\\b",
      "name": "Abertura \"você sabia que\"",
      "fix": "Pergunta retórica no começo vira conversa de palestra. Diga o fato."
    },
    {
      "id": "vocabulario-ia",
      "regex": "(?i)\\b(?:alavanc\\w+|potencializ\\w+|transformador\\w*|revolucion\\w+|holistic\\w+|robust\\w+|sinergia|ecossistema|paradigma|resilient\\w+|disruptiv\\w+|desbloque\\w+|jornada)\\b",
      "name": "Vocabulário típico de texto de IA",
      "fix": "Troque por a palavra que você usaria no WhatsApp (sem trocar de forma automática: gênero e número mudam)."
    },
    {
      "id": "mundo-cada-vez",
      "regex": "(?i)\\bem um mundo (?:cada vez mais|onde)\\b",
      "name": "Abertura de mundo cada vez mais...",
      "fix": "Comece pelo assunto."
    },
    {
      "id": "fecho-resumo",
      "regex": "(?im)^\\s*(?:em (?:resumo|conclus[aã]o)|portanto|dessa forma)\\b",
      "name": "Fecho de redação (em resumo, portanto)",
      "fix": "Termine na ação ou no último fato, não numa recapitulação."
    },
    {
      "id": "parede-hashtag",
      "regex": "(?:#\\w+\\s+){6,}",
      "name": "Parede de hashtags",
      "fix": "Poucas e específicas, no fim da legenda."
    },
    {
      "id": "emoji-lista",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅❌➡✔👉]\\s",
      "name": "Lista com emoji como marcador",
      "fix": "Escreva em frases, como se falasse."
    },
    {
      "id": "tres-gritadas",
      "regex": "\\b[A-ZÁÉÍÓÚÂÊÔÃÕÇ]{3,}\\b(?:\\s+[A-ZÁÉÍÓÚÂÊÔÃÕÇ]{3,}\\b){2,}",
      "name": "Três palavras gritadas em sequência",
      "fix": "Na legenda, caixa alta em trecho longo vira ruído. Na tela do vídeo é outra conta."
    }
  ]
}